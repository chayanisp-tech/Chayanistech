rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && request.auth.token.email == "chayanisp@banmuang.ac.th";
    }

    /**
     * นักเรียน
     * อ่านได้เฉพาะ document ที่รู้รหัสตัวเอง
     */
    match /students/{studentId} {
      allow get: if true;

      allow list: if isTeacher();

      allow create, update, delete: if isTeacher();
    }

    /**
     * Legacy teacher documents contain answerIndex and must never be readable
     * by an unauthenticated student browser.
     */
    match /exams/{examId} {
      allow read: if isTeacher();

      allow create, update, delete: if isTeacher();
    }

    /**
     * Student-safe exam payload. answerIndex must never be stored here.
     */
    match /exams_public/{examId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    /**
     * Server-only answer keys. Vercel uses a service account, while browser
     * clients are limited to the authenticated teacher account.
     */
    match /exam_answer_keys/{examId} {
      allow read, create, update, delete: if isTeacher();
    }

    /**
     * Submission
     *
     * Browser access is teacher-only. Student reads and writes go through the
     * Vercel server endpoints so scores cannot be supplied by the client.
     */
    match /submissions/{submissionId} {
      allow read: if isTeacher();
      allow create, update, delete: if isTeacher();
    }

    /**
     * Settings
     */
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isTeacher();
    }

    /**
     * ปิดทุก collection อื่นโดย default
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
