rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && request.auth.token.email == "chayanisp@banmuang.ac.th";
    }

    /**
     * นักเรียน
     * อ่านได้เฉพาะ document ที่รู้รหัสตัวเอง
     */
    match /students/{studentId} {
      allow get: if true;

      allow list: if isTeacher();

      allow create, update, delete: if isTeacher();
    }

    /**
     * ข้อสอบ
     * นักเรียนอ่านได้
     * ครูจัดการได้
     *
     * รอบถัดไปเราจะปรับให้ไม่ส่งเฉลยลง client
     */
    match /exams/{examId} {
      allow read: if true;

      allow create, update, delete: if isTeacher();
    }

    /**
     * Submission
     *
     * นักเรียนสามารถ query เฉพาะ studentId
     * และเขียนผลของตัวเองได้
     *
     * ครูอ่าน/แก้ได้ทั้งหมด
     */
    match /submissions/{submissionId} {
      allow read: if isTeacher();

      allow create: if
        request.resource.data.studentId is string
        && request.resource.data.examId is string
        && request.resource.data.submissionId == submissionId
        && submissionId ==
          request.resource.data.examId
          + "_"
          + request.resource.data.studentId;

      allow update: if
        isTeacher()
        || (
          resource.data.studentId ==
            request.resource.data.studentId
          &&
          resource.data.examId ==
            request.resource.data.examId
          &&
          resource.data.submissionId ==
            request.resource.data.submissionId
        );

      allow delete: if isTeacher();
    }

    /**
     * Settings
     */
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isTeacher();
    }

    /**
     * ปิดทุก collection อื่นโดย default
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
