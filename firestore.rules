rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn()
        && request.auth.token.email == "chayanisp@banmuang.ac.th";
    }

    /**
     * นักเรียน
     * อ่านได้เฉพาะ document ที่รู้รหัสตัวเอง
     */
    match /students/{studentId} {
      allow get: if true;

      allow list: if isTeacher();

      allow create, update, delete: if isTeacher();
    }

    /**
     * Legacy exam documents. Public read remains temporarily enabled until
     * every active exam has been copied and the student read path is switched.
     */
    match /exams/{examId} {
      allow read: if true;

      allow create, update, delete: if isTeacher();
    }

    /**
     * Student-safe exam payload. answerIndex must never be stored here.
     */
    match /exams_public/{examId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    /**
     * Server-only answer keys. Vercel uses a service account, while browser
     * clients are limited to the authenticated teacher account.
     */
    match /exam_answer_keys/{examId} {
      allow read, create, update, delete: if isTeacher();
    }

    /**
     * Submission
     *
     * นักเรียนสามารถ query เฉพาะ studentId
     * และเขียนผลของตัวเองได้
     *
     * ครูอ่าน/แก้ได้ทั้งหมด
     */
    match /submissions/{submissionId} {
      allow read: if isTeacher();

      allow create: if
        request.resource.data.studentId is string
        && request.resource.data.examId is string
        && request.resource.data.submissionId == submissionId
        && submissionId ==
          request.resource.data.examId
          + "_"
          + request.resource.data.studentId;

      allow update: if
        isTeacher()
        || (
          resource.data.studentId ==
            request.resource.data.studentId
          &&
          resource.data.examId ==
            request.resource.data.examId
          &&
          resource.data.submissionId ==
            request.resource.data.submissionId
        );

      allow delete: if isTeacher();
    }

    /**
     * Settings
     */
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isTeacher();
    }

    /**
     * ปิดทุก collection อื่นโดย default
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
